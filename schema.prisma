generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Analysis {
  id        String       @id @default(cuid())
  decision  DecisionType
  btcPrice  BigInt
  createdAt DateTime     @default(now()) @map(name: "created_at")
}

model ApiKey {
  id        String   @id @default(cuid())
  apiKey    String
  createdAt DateTime @default(now()) @map(name: "created_at")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map(name: "apiKey")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map(name: "created_at")
  apiKeys   ApiKey[]
}

model Decision {
  id        String       @id @default(cuid())
  decision  DecisionType
  createdAt DateTime     @default(now()) @map(name: "created_at")
}

enum DecisionType {
  BUY
  SELL
  HOLD
  DO_NOTHING @map("DO NOTHING")
  DCA
}
