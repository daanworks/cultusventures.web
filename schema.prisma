generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Sentiment {
  id               String    @id @default(cuid())
  btcPrice         BigInt
  score            Float
  explanation      String
  endOfCycleChance Float
  trend            TrendType
  createdAt        DateTime  @default(now()) @map(name: "created_at")
}

model ApiKey {
  id        String   @id @default(cuid())
  apiKey    String
  createdAt DateTime @default(now()) @map(name: "created_at")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map(name: "apiKey")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  telegramUser Boolean  @default(true)
  createdAt    DateTime @default(now()) @map(name: "created_at")
  apiKeys      ApiKey[]
}

model Trend {
  id        String    @id @default(cuid())
  type      TrendType
  createdAt DateTime  @default(now()) @map(name: "created_at")
}

enum TrendType {
  BULLISH
  BEARISH
}
